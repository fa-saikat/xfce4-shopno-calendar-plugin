# Maintainer: FA Saikat <fahimabrar.saikat@gmail.com>

pkgname=xfce4-shopno-calendar-plugin
pkgver=0.1.0
pkgrel=1
pkgdesc='Clock and calendar flyout for the Xfce panel'
arch=('x86_64' 'aarch64')
url='https://github.com/fa-saikat/xfce4-shopno-calendar-plugin'
license=('GPL-2.0-or-later')
depends=('glib2' 'gtk3' 'libxfce4ui' 'libxfce4util' 'xfce4-panel' 'xfconf')
makedepends=('gettext' 'meson')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
# Built in CI from the checked-out tree; run updpkgsums before building
# from the release tarball
sha256sums=('SKIP')

build() {
  arch-meson "$pkgname-$pkgver" build -Dpreview=false
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
}
